# Bridge Interactive API Configuration
# Documentation: https://bridgedataoutput.com/docs/platform/API/reso-web-api

# API Base URL
BRIDGE_API_BASE_URL=https://api.bridgedataoutput.com/api/v2

# PRIMARY AUTHENTICATION: Server Token (Required)
BRIDGE_SERVER_TOKEN=your_server_token_here

# MLS Identifier (Required)
BRIDGE_MLS_ID=your_mls_id_here

# MCP Server Configuration
MCP_SERVER_NAME=unlock-mls-mcp
LOG_LEVEL=ERROR

# Optional: OAuth2 Client Credentials (for legacy compatibility only)
# BRIDGE_CLIENT_ID=your_client_id_here  
# BRIDGE_CLIENT_SECRET=your_client_secret_here

# Optional: API Rate Limiting
# API_RATE_LIMIT_PER_MINUTE=60

# Optional: Cache Configuration
# CACHE_ENABLED=false
# CACHE_TTL_SECONDS=300

# Google Maps API Configuration
# Required for location-based property searches (find_properties_near_location tool)
# Get your API key from: https://console.developers.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Google Maps Configuration
# GOOGLE_MAPS_CACHE_TTL_HOURS=24
# GOOGLE_MAPS_MAX_REQUESTS_PER_DAY=800
# GOOGLE_MAPS_ENABLE_CACHING=true